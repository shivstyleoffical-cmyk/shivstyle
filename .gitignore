# Root gitignore for Ecommerce App monorepo

# Node/npm dependency directories
node_modules/
**/node_modules/

# Local env files
.env
.env.*
**/.env
**/.env.*

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
*.local

# Build and output directories
dist/
**/dist/
build/
**/build/
.cache/
.parcel-cache/
.eslintcache

# Logs
*.log
logs/
**/logs/
